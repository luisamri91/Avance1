fontColor=#000000;" vertex="1" connectable="0" parent="p1r12"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1r13" value="vendedor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#000000;strokeColor=#000000;exitX=0.750;exitY=1.000;exitDx=0;exitDy=0;entryX=0.332;entryY=0.000;entryDx=0;entryDy=0;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1" source="p1c10" target="p1c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="456"/><mxPoint x="1029" y="456"/></Array></mxGeometry></mxCell><mxCell id="p1r13t0" value="*" style="edgeLabel;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="p1r13"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1r13t1" value="1" style="edgeLabel;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="p1r13"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1leyenda" value="&lt;b&gt;Simbología del diagrama&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;align=center;verticalAlign=top;spacingTop=6;fontSize=14;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="1192" width="1214" height="462" as="geometry"/></mxCell><mxCell id="p1la0" value="&lt;b&gt;Partes de cada clase&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="32" y="1232" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1la1m" value="&lt;b&gt;Nombre&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1256" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la1" value="Arriba va el nombre de la clase; en el medio, sus atributos; abajo, sus métodos." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1254" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la2m" value="nombre : Tipo" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1280" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la2" value="Atributo y su tipo de dato. Ejemplo: &lt;i&gt;existencias : int&lt;/i&gt;." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1278" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la3m" value="metodo(…) : Tipo" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1304" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1la3" value="Método, los datos que recibe y el tipo de dato que devuelve (&lt;i&gt;void&lt;/i&gt; = no devuelve nada)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1302" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1la4" value="&lt;b&gt;Visibilidad&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="32" y="1346" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1la5m" value="+" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1370" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la5" value="Público: cualquier clase lo puede usar." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1368" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la6m" value="-" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1394" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la6" value="Privado: solo lo usa la misma clase." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1392" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la7m" value="#" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1418" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la7" value="Protegido: lo usan la clase y sus subclases." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1416" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la8" value="&lt;b&gt;Otros símbolos&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="32" y="1446" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1la9m" value="&lt;u&gt;subrayado&lt;/u&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1470" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1la9" value="Static: pertenece a la clase y no a cada objeto (por ejemplo, el contador de ids)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1468" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1la10m" value="&lt;i&gt;cursiva&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1508" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1la10" value="Abstracto: la clase no se puede instanciar o el método no tiene código y lo escribe cada subclase." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1506" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1la11m" value="«abstract»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1546" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la11" value="Clase abstracta: sirve de base para otras clases (Persona, Producto)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1544" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la12m" value="«interface»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1570" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1la12" value="Interface: lista de métodos que las clases que la implementan están obligadas a tener." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1568" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1lb0" value="&lt;b&gt;Multiplicidad (cuántos objetos se relacionan)&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="642" y="1232" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1lb1m" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1256" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb1" value="Exactamente uno." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1254" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb2m" value="*" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1280" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb2" value="Cero o muchos." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1278" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb3m" value="1..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1304" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb3" value="Uno o muchos (al menos uno)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1302" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb4" value="Ejemplo: Factura &lt;b&gt;*&lt;/b&gt; → &lt;b&gt;1&lt;/b&gt; Cliente se lee &quot;cada factura es de un cliente y un cliente puede tener muchas facturas&quot;." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="642" y="1326" width="580" height="36" as="geometry"/></mxCell><mxCell id="p1lb5" value="&lt;b&gt;Relaciones&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="642" y="1370" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1lb6f" style="html=1;strokeColor=#000000;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646.1" y="1403" as="sourcePoint"/><mxPoint x="736.1" y="1403" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1lb6" value="Herencia: la subclase &lt;i&gt;es un&lt;/i&gt; tipo de la superclase (Usuario es una Persona)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1392" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb7f" style="html=1;strokeColor=#000000;endArrow=block;endFill=0;endSize=12;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646.1" y="1427" as="sourcePoint"/><mxPoint x="736.1" y="1427" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1lb7" value="Implementación: la clase cumple una interface (Producto implementa Mostrable)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1416" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb8f" style="html=1;strokeColor=#000000;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646.1" y="1458" as="sourcePoint"/><mxPoint x="736.1" y="1458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1lb8" value="Composición: el todo contiene sus partes y estas no existen sin él (Factura y sus detalles)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1440" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1lb9f" style="html=1;strokeColor=#000000;startArrow=diamondThin;startFill=0;startSize=14;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646.1" y="1496" as="sourcePoint"/><mxPoint x="736.1" y="1496" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1lb9" value="Agregación: el todo agrupa partes que pueden existir por separado (Categoría y sus productos)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1478" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1lb10f" style="html=1;strokeColor=#000000;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646.1" y="1527" as="sourcePoint"/><mxPoint x="736.1" y="1527" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1lb10" value="Asociación: una clase conoce y usa a otra (la Factura conoce a su Cliente)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1516" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb11" value="&lt;b&gt;Colecciones&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="642" y="1546" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1lb12m" value="List&amp;lt;Tipo&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1570" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1lb12" value="Lista: guarda los objetos en orden (las líneas de una factura, los productos de una categoría)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1568" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1lb13" value="En el diagrama completo también hay &lt;b&gt;Set&lt;/b&gt; (no acepta repetidos) y &lt;b&gt;Map&lt;/b&gt; / &lt;b&gt;TreeMap&lt;/b&gt; (guarda cada objeto con una clave, como el id del cliente o el número de factura)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="642" y="1606" width="580" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
