n=bottom;fontSize=11;fontColor=#D35400;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="p1r11"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1r12" value="tiene cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#D35400;strokeColor=#D35400;strokeWidth=2;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.498;exitY=1.000;exitDx=0;exitDy=0;entryX=0.333;entryY=0.000;entryDx=0;entryDy=0;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1" source="p1c10" target="p1c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="817" y="436"/><mxPoint x="696" y="436"/></Array></mxGeometry></mxCell><mxCell id="p1r12t0" value="* (muchos)" style="edgeLabel;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#D35400;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="p1r12"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1r12t1" value="1" style="edgeLabel;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#D35400;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="p1r12"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1r13" value="tiene vendedor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#D35400;strokeColor=#D35400;strokeWidth=2;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.750;exitY=1.000;exitDx=0;exitDy=0;entryX=0.332;entryY=0.000;entryDx=0;entryDy=0;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1" source="p1c10" target="p1c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="456"/><mxPoint x="1029" y="456"/></Array></mxGeometry></mxCell><mxCell id="p1r13t0" value="* (muchos)" style="edgeLabel;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#D35400;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="p1r13"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1r13t1" value="1" style="edgeLabel;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#D35400;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="p1r13"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1leyenda" value="&lt;b&gt;Simbología del diagrama&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;align=center;verticalAlign=top;spacingTop=6;fontSize=14;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="1192" width="1214" height="452" as="geometry"/></mxCell><mxCell id="p1la0" value="&lt;b&gt;Cómo leer las líneas (cada tipo tiene su color)&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="32" y="1232" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1la1f" style="html=1;strokeWidth=2;strokeColor=#1F5FA8;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="1272" as="sourcePoint"/><mxPoint x="126" y="1272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1la1" value="&lt;b&gt;es un&lt;/b&gt; (herencia): el triángulo señala a la clase padre. &lt;i&gt;Usuario es una Persona; Bebida es un Producto.&lt;/i&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1254" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1la2f" style="html=1;strokeWidth=2;strokeColor=#7B3FA0;endArrow=block;endFill=0;endSize=12;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="1310" as="sourcePoint"/><mxPoint x="126" y="1310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1la2" value="&lt;b&gt;implementa&lt;/b&gt; (línea punteada): la clase cumple lo que pide la interface. &lt;i&gt;Factura implementa Mostrable, así que tiene mostrarInformacion().&lt;/i&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1292" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1la3f" style="html=1;strokeWidth=2;strokeColor=#C0392B;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="1348" as="sourcePoint"/><mxPoint x="126" y="1348" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1la3" value="&lt;b&gt;contiene&lt;/b&gt; (rombo relleno, del lado del todo): las partes no existen sin el todo. &lt;i&gt;Si se borra la Factura, se borran sus detalles.&lt;/i&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1330" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1la4f" style="html=1;strokeWidth=2;strokeColor=#2E8B57;startArrow=diamondThin;startFill=0;startSize=14;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="1386" as="sourcePoint"/><mxPoint x="126" y="1386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1la4" value="&lt;b&gt;agrupa&lt;/b&gt; (rombo vacío, del lado del grupo): las partes existen por separado. &lt;i&gt;Si se borra una Categoría, sus productos pueden seguir existiendo.&lt;/i&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1368" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1la5f" style="html=1;strokeWidth=2;strokeColor=#D35400;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="1424" as="sourcePoint"/><mxPoint x="126" y="1424" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1la5" value="&lt;b&gt;usa&lt;/b&gt; (flecha abierta): la clase guarda una referencia a la otra. &lt;i&gt;La Factura sabe quién es su cliente y su vendedor.&lt;/i&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1406" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1la6" value="&lt;b&gt;Números en los extremos de las líneas&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="32" y="1450" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1la7m" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1474" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la7" value="Uno." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1472" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la8m" value="* (muchos)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1498" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la8" value="Cero o muchos." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1496" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la9m" value="1..* (uno o más)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="32" y="1522" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1la9" value="Al menos uno." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="1520" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1la10" value="Se lee de una clase a la otra: Factura &lt;b&gt;* (muchos)&lt;/b&gt; — &lt;b&gt;1&lt;/b&gt; Cliente = &quot;cada factura es de &lt;b&gt;un&lt;/b&gt; cliente y un cliente tiene &lt;b&gt;muchas&lt;/b&gt; facturas&quot;." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="32" y="1544" width="580" height="36" as="geometry"/></mxCell><mxCell id="p1lb0" value="&lt;b&gt;Partes de cada clase&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="642" y="1232" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1lb1m" value="&lt;b&gt;Nombre&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1256" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1lb1" value="Arriba el nombre; en el medio los atributos (datos); abajo los métodos (acciones)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1254" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1lb2m" value="nombre : Tipo" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1294" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb2" value="Atributo y su tipo de dato. Ejemplo: &lt;i&gt;existencias : int&lt;/i&gt;." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1292" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb3m" value="metodo(…) : Tipo" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1318" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb3" value="Método, lo que recibe y lo que devuelve (&lt;i&gt;void&lt;/i&gt; = no devuelve nada)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1316" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb4" value="&lt;b&gt;Símbolo antes de cada atributo o método&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="642" y="1346" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1lb5m" value="+" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1370" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb5" value="Público: lo usa cualquier clase." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1368" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb6m" value="-" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1394" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb6" value="Privado: solo lo usa la misma clase." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1392" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb7m" value="#" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1418" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb7" value="Protegido: lo usan la clase y sus clases hijas." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1416" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb8" value="&lt;b&gt;Clases especiales&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="642" y="1446" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1lb9m" value="«abstract»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1470" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1lb9" value="Clase abstracta (nombre en cursiva): no se crean objetos de ella, solo de sus hijas (Persona, Producto)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1468" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1lb10m" value="«interface»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1508" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1lb10" value="Interface: lista de métodos que deben tener las clases que la implementan (Mostrable)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1506" width="454" height="36" as="geometry"/></mxCell><mxCell id="p1lb11m" value="&lt;i&gt;cursiva&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1546" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1lb11" value="Método abstracto: cada clase hija escribe su propio código." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1544" width="454" height="22" as="geometry"/></mxCell><mxCell id="p1lb12" value="&lt;b&gt;Colecciones&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="642" y="1574" width="580" height="22" as="geometry"/></mxCell><mxCell id="p1lb13m" value="List&amp;lt;Tipo&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="642" y="1598" width="100" height="32" as="geometry"/></mxCell><mxCell id="p1lb13" value="Lista de objetos en orden (los detalles de una factura, los productos de una categoría)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="752" y="1596" width="454" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
