endFill=0;endSize=10;" edge="1" parent="1" source="p1c10" target="p1c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="381"/><mxPoint x="1068" y="381"/></Array></mxGeometry></mxCell><mxCell id="p1r13t0" value="*" style="edgeLabel;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="p1r13"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1r13t1" value="1" style="edgeLabel;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="p1r13"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="p1leyenda" value="&lt;b&gt;Simbología del diagrama&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;align=center;verticalAlign=top;spacingTop=6;fontSize=14;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1410" y="20" width="560" height="772" as="geometry"/></mxCell><mxCell id="p1l0" value="&lt;b&gt;Partes de cada clase&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1422" y="60" width="536" height="22" as="geometry"/></mxCell><mxCell id="p1l1m" value="&lt;b&gt;Nombre&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="84" width="100" height="30" as="geometry"/></mxCell><mxCell id="p1l1" value="Arriba va el nombre de la clase; en el medio, sus atributos; abajo, sus métodos." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="82" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l2m" value="nombre : Tipo" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="120" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1l2" value="Atributo y su tipo de dato. Ejemplo: &lt;i&gt;existencias : int&lt;/i&gt;." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="118" width="422" height="22" as="geometry"/></mxCell><mxCell id="p1l3m" value="metodo(…) : Tipo" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="144" width="100" height="30" as="geometry"/></mxCell><mxCell id="p1l3" value="Método, los datos que recibe y el tipo de dato que devuelve (&lt;i&gt;void&lt;/i&gt; = no devuelve nada)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="142" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l4" value="&lt;b&gt;Visibilidad&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1422" y="184" width="536" height="22" as="geometry"/></mxCell><mxCell id="p1l5m" value="+" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="208" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1l5" value="Público: cualquier clase lo puede usar." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="206" width="422" height="22" as="geometry"/></mxCell><mxCell id="p1l6m" value="-" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="232" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1l6" value="Privado: solo lo usa la misma clase." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="230" width="422" height="22" as="geometry"/></mxCell><mxCell id="p1l7m" value="#" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="256" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1l7" value="Protegido: lo usan la clase y sus subclases." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="254" width="422" height="22" as="geometry"/></mxCell><mxCell id="p1l8" value="&lt;b&gt;Otros símbolos&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1422" y="284" width="536" height="22" as="geometry"/></mxCell><mxCell id="p1l9m" value="&lt;u&gt;subrayado&lt;/u&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="308" width="100" height="30" as="geometry"/></mxCell><mxCell id="p1l9" value="Static: pertenece a la clase y no a cada objeto (por ejemplo, el contador de ids)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="306" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l10m" value="&lt;i&gt;cursiva&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="344" width="100" height="30" as="geometry"/></mxCell><mxCell id="p1l10" value="Abstracto: la clase no se puede instanciar o el método no tiene código y lo escribe cada subclase." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="342" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l11m" value="«abstract»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="380" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1l11" value="Clase abstracta: sirve de base para otras clases (Persona, Producto)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="378" width="422" height="22" as="geometry"/></mxCell><mxCell id="p1l12m" value="«interface»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="404" width="100" height="30" as="geometry"/></mxCell><mxCell id="p1l12" value="Interface: lista de métodos que las clases que la implementan están obligadas a tener." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="402" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l13" value="&lt;b&gt;Multiplicidad (cuántos objetos se relacionan)&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1422" y="444" width="536" height="22" as="geometry"/></mxCell><mxCell id="p1l14m" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="468" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1l14" value="Exactamente uno." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="466" width="422" height="22" as="geometry"/></mxCell><mxCell id="p1l15m" value="*" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="492" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1l15" value="Cero o muchos." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="490" width="422" height="22" as="geometry"/></mxCell><mxCell id="p1l16m" value="1..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1426" y="516" width="100" height="18" as="geometry"/></mxCell><mxCell id="p1l16" value="Uno o muchos (al menos uno)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="514" width="422" height="22" as="geometry"/></mxCell><mxCell id="p1l17" value="Ejemplo: Factura &lt;b&gt;*&lt;/b&gt; → &lt;b&gt;1&lt;/b&gt; Cliente se lee &quot;cada factura es de un cliente y un cliente puede tener muchas facturas&quot;." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1422" y="538" width="536" height="34" as="geometry"/></mxCell><mxCell id="p1l18" value="&lt;b&gt;Relaciones&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1422" y="580" width="536" height="22" as="geometry"/></mxCell><mxCell id="p1l19f" style="html=1;strokeColor=#000000;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1426.1" y="619" as="sourcePoint"/><mxPoint x="1516.1" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1l19" value="Herencia: la subclase &lt;i&gt;es un&lt;/i&gt; tipo de la superclase (Usuario es una Persona)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="602" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l20f" style="html=1;strokeColor=#000000;endArrow=block;endFill=0;endSize=12;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1426.1" y="655" as="sourcePoint"/><mxPoint x="1516.1" y="655" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1l20" value="Implementación: la clase cumple una interface (Producto implementa Mostrable)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="638" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l21f" style="html=1;strokeColor=#000000;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1426.1" y="691" as="sourcePoint"/><mxPoint x="1516.1" y="691" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1l21" value="Composición: el todo contiene sus partes y estas no existen sin él (Factura y sus detalles)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="674" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l22f" style="html=1;strokeColor=#000000;startArrow=diamondThin;startFill=0;startSize=14;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1426.1" y="727" as="sourcePoint"/><mxPoint x="1516.1" y="727" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1l22" value="Agregación: el todo agrupa partes que pueden existir por separado (Categoría y sus productos)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="710" width="422" height="34" as="geometry"/></mxCell><mxCell id="p1l23f" style="html=1;strokeColor=#000000;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1426.1" y="763" as="sourcePoint"/><mxPoint x="1516.1" y="763" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1l23" value="Asociación: una clase conoce y usa a otra (la Factura conoce a su Cliente)." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1536" y="746" width="422" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
