classDiagram
    direction TB

    class Mostrable {
        <<interface>>
        +mostrarInformacion() String
    }
    class Persona {
        <<abstract>>
        #String nombre
        #String telefono
        #String correo
        #TipoIdentificacion tipoIdentificacion
        #String identificacion
        +mostrarInformacion() String
    }
    class Usuario {
        -String nombreUsuario
        -String contrasena
        -Rol rol
        -boolean activo
        +validarCredenciales(String, String) boolean
        +esAdministrador() boolean
    }
    class Cliente {
        -String direccion
        -boolean activo
    }
    class Producto {
        <<abstract>>
        #String codigo
        #String nombre
        #double valorVenta
        #int existencias
        #int stockMinimo
        +obtenerPorcentajeImpuesto()* double
        +descontarExistencias(int) void
        +necesitaReabastecer() boolean
    }
    class Abarrote {
        -LocalDate fechaVencimiento
        -boolean canastaBasica
        +obtenerPorcentajeImpuesto() double
    }
    class Bebida {
        -int volumenMl
        -boolean retornable
        +obtenerPorcentajeImpuesto() double
    }
    class ArticuloHogar {
        -String marca
        -String presentacion
        +obtenerPorcentajeImpuesto() double
    }
    class Categoria {
        -String nombre
        -List~Producto~ productos
        +agregarProducto(Producto) void
        +eliminarProducto(int) void
    }
    class Inventario {
        -List~Categoria~ categorias
        +buscarProducto(String) Producto
        +productosBajoMinimo() List~Producto~
    }
    class Factura {
        -int numero
        -LocalDateTime fecha
        -MetodoPago metodoPago
        -EstadoFactura estado
        -List~DetalleFactura~ detalles
        +agregarDetalle(Producto, int) void
        +calcularTotal() double
        +anular() void
        +generarArchivo(String) void
    }
    class DetalleFactura {
        -int cantidad
        -double precioUnitario
        +calcularSubtotal() double
        +calcularImpuesto() double
    }

    Mostrable <|.. Persona
    Mostrable <|.. Producto
    Mostrable <|.. Factura
    Persona <|-- Usuario
    Persona <|-- Cliente
    Producto <|-- Abarrote
    Producto <|-- Bebida
    Producto <|-- ArticuloHogar
    Inventario "1" o-- "*" Categoria
    Categoria "1" o-- "*" Producto
    Factura "1" *-- "1..*" DetalleFactura
    DetalleFactura "*" --> "1" Producto : producto vendido
    Factura "*" --> "1" Cliente : tiene cliente
    Factura "*" --> "1" Usuario : tiene vendedor
